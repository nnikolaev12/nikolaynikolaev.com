---
import type { Project } from "../types/project";
import ProjectsSlider from "./projects/ProjectsSlider.astro";

interface NavItem {
	label: string;
	href: string;
}

interface PartnerLogo {
	src: string;
	alt: string;
}

interface Technology {
	label: string;
	icon: string;
}

interface SocialLink {
	label: string;
	href: string;
}

interface CtaAction {
	label: string;
	href: string;
	variant: "primary" | "secondary";
	target: "_blank" | "_self";
}

const navItems: NavItem[] = [
	{ label: "Partners", href: "#partners" },
	{ label: "Tech", href: "#stack" },
	{ label: "Case Studies", href: "#projects" },
];

const partnerLogos: PartnerLogo[] = [
	{
		src: "/img/logos/yotpo-logo.svg",
		alt: "Yotpo Logo",
	},
	{
		src: "/img/logos/sensity-logo.webp",
		alt: "Sensity Logo",
	},
	{
		src: "/img/logos/upc-logo.webp",
		alt: "Ultimate Poker Coaching Logo",
	},
	{
		src: "/img/logos/blubito-logo.webp",
		alt: "Blubito Logo",
	},
	{
		src: "/img/logos/fs-logo.webp",
		alt: "Fantastic Services Logo",
	}
];

const technologies: Technology[] = [
	{ label: "WordPress / Shopify", icon: "web" },
	{ label: "PostgreSQL / MySQL", icon: "database" },
	{ label: "AWS / Google / Cloudflare", icon: "cloud" },
	{ label: "AI Integrations / Agentic AI", icon: "robot" },
	{ label: "SEO / GEO", icon: "search" },
	{ label: "A/B Testing / Analytics", icon: "analytics" },
];

const projects: Project[] = [
	{
		title: "Yotpo",
		innerTitle: "Scaling the Marketing Engine for an Enterprise Giant",
		description:
			"Engineered a highly flexible, custom block-based page builder and integrated AI agentic workflows for a high-traffic enterprise marketing website. Fortified the infrastructure with advanced AWS caching and security protocols. This accelerated content deployment and eliminated technical bottlenecks, allowing the marketing team to execute campaigns autonomously.",
		mainContent:
			"<ul><li><strong>The Challenge:</strong> A high-traffic, enterprise-level marketing website (yotpo.com) requires rapid content iteration, flawless performance under heavy load, and robust tracking to drive marketing campaigns and conversions. <li><strong>The Solution:</strong> I architected and maintained a custom, highly flexible Gutenberg block-based page builder, empowering the marketing team to build pages autonomously. To accelerate production, I integrated cutting-edge AI agentic workflows for front-end development and content management. The infrastructure is heavily fortified using AWS for advanced caching, migration, and security. <li><strong>The Tech Stack:</strong> WordPress, AWS, Custom Gutenberg Blocks, AI Workflows, A/B Testing & Advanced Analytics. <li><strong>The Impact:</strong> Eliminated technical bottlenecks for the marketing team, enabling them to launch, test, and optimize high-converting campaigns rapidly while easily handling massive, enterprise-level web traffic without performance drops.</li></ul>",
		imageSrc:
			"/img/projects/yotpo-desktop.webp",
		imageAlt: "Yotpo",
		tags: ["WordPress", "AWS"],
		href: "https://yotpo.com/",
	},
	{
		title: "Ultimate Poker Coaching",
		innerTitle: "A Frictionless Marketplace & Scheduling Platform",
		mainContent:
			"<ul><li><strong>The Challenge:</strong> The client required a centralized, all-in-one platform to seamlessly connect poker coaches with students, needing to handle everything from user discovery to secure payments and calendar management without bottlenecks. <li><strong>The Solution:</strong> I engineered a custom, multi-functional WordPress platform designed to automate the entire coaching lifecycle. I integrated Stripe for secure, automated payment processing and built robust scheduling features that allow coaches to manage their availability effortlessly. The infrastructure was routed through Cloudflare to guarantee fast global delivery and enterprise-grade security. <li><strong>The Tech Stack:</strong> Custom WordPress, Stripe API Integration, Cloudflare, Complex Scheduling Architecture. <li><strong>The Impact:</strong> Created a seamless end-to-end user experience that eliminated administrative friction, empowering coaches to easily monetize their skills and allowing the business to scale its user base and revenue efficiently.</li></ul>",
		description:
			"Architected a custom, multi-functional marketplace platform to seamlessly connect coaches with students and manage the entire coaching lifecycle. Integrated automated Stripe payment processing and robust calendar scheduling within a secure, Cloudflare-backed infrastructure. This created a frictionless user experience that empowered coaches to effortlessly monetize their skills and scale revenue.",
		imageSrc:
			"/img/projects/ultimatepokercoaching-desktop.webp",
		imageAlt: "Ultimate Poker Coaching",
		tags: ["WordPress", "Cloudflare", "Stripe"],
		href: "https://ultimatepokercoaching.com/",
		reverse: true,
	},
	{
		title: "Sensity AI",
		innerTitle: "A High-Performance Multilingual Hub for Cutting-Edge AI Security",
		mainContent: "<ul><li><strong>The Challenge:</strong> A sophisticated AI security company needed a powerful digital presence to showcase their \"forensic-grade deepfake detection hub\". The site had to communicate complex technical concepts globally, rank highly in search engines, and be easily scalable by their internal marketing team. <li><strong>The Solution:</strong> I built a blazing-fast, multilingual marketing website specifically optimized for performance and global SEO. The architecture was designed to flawlessly present custom, high-fidelity visuals of their deepfake investigations while providing an intuitive, flexible backend for the marketing team to rapidly deploy new content and campaigns. <li><strong>The Tech Stack:</strong> High-Performance Web Development, Multilingual Architecture, Technical SEO Optimization, Custom Visual Integrations. <li><strong>The Impact:</strong> Delivered a globally accessible, lightning-fast digital asset that ranks competitively in search engines and provides the marketing team with total autonomy to scale their content and drive lead generation without relying on constant developer support.</li></ul>",
		description:
			"Built a high-performance, multilingual digital hub designed to showcase forensic-grade AI security investigations globally. Optimized the technical architecture for top-tier SEO, custom high-fidelity visual delivery, and rapid content scaling. This provided the marketing team with a blazing-fast, autonomous asset to drive global lead generation.",
		imageSrc:
			"/img/projects/sensity-desktop.webp",
		imageAlt: "Sensity AI",
		tags: ["WordPress"],
		href: "https://sensity.ai/",
	},
	{
		title: "Hermes Plugin",
		innerTitle: "Centralizing Infrastructure for High-Traffic iGaming Media",
		mainContent: "<ul><li><strong>The Challenge:</strong> Managing and scaling functionality across multiple high-traffic media websites (attracting millions of monthly visitors) in the fiercely competitive iGaming industry. <li><strong>The Solution:</strong> Maintained, optimized, and significantly extended a centralized custom WordPress plugin (Hermes) that powers multiple company domains. I developed tailored Gutenberg blocks for rapid content deployment, integrated complex third-party APIs, and engineered custom usage-tracking solutions. <li><strong>The Tech Stack:</strong> WordPress Plugin Development, PHP, Third-Party API Integration, Gutenberg, Web Performance Optimization. <li><strong>The Impact:</strong> Delivered lightning-fast loading times and seamless user experiences for millions of users, while drastically reducing the operational overhead for content teams by centralizing multi-site management into a single powerful plugin.</li></ul>",
		description:
			"Maintained and significantly extended a centralized custom WordPress plugin that powers multiple high-traffic media domains in the competitive iGaming sector. Developed tailored Gutenberg blocks and complex API integrations to streamline multi-site content management. This drastically reduced operational overhead while ensuring lightning-fast performance for millions of monthly visitors.",
		imageSrc:
			"/img/projects/onthedotmedia-desktop.png",
		imageAlt: "",
		tags: ["WordPress", "Google Cloud"],
		href: "#",
		reverse: true,
	}
];

const socialLinks: SocialLink[] = [
	{ label: "LinkedIn", href: "https://www.linkedin.com/in/nikolay-nikolaev-78992268/" },
	{ label: "GitHub", href: "https://github.com/nnikolaev12" },
	{ label: "Email", href: "mailto:me@nikolaynikolaev.com" },
];

const ctaActions: CtaAction[] = [
	{ label: "Book a Meeting", href: "https://calendar.app.google/cKy7EK93wS6esepB6", variant: "primary", target: "_blank" },
	{ label: "Email Me", href: "mailto:me@nikolaynikolaev.com", variant: "secondary", target: "_self" },
];

const heroCodeSnippet = `const Engineer = {
  name: 'Nick',
  role: 'Full Stack Web Engineer',
  skills: [
    'Software Engineering',
	'Infrastructure', 'SEO/GEO',
	'AI Integration',
  ],
  mission: 'Engineered for Growth',
  execute: () => {
    return buildRobustSolutions();
  }
};`;

const currentYear = new Date().getFullYear();
---

<header
	class="fixed top-0 w-full z-[100] bg-background/90 backdrop-blur-md border-b border-outline-variant"
>
	<div
		class="flex justify-between items-center max-w-container-max mx-auto px-margin-page h-20"
	>
		<a href="/" class="flex items-center gap-4">
			<img
				alt="Nikolay Nikolaev Logo"
				class="h-10 w-auto"
				src="/img/logos/nn-logo-transp.webp"
				width="40"
				height="40"
				loading="eager"
				decoding="async"
			/>
			<span
				class="font-headline-md text-headline-md font-extrabold text-on-background hidden md:block"
			>
				Nick Nikolaev
			</span>
		</a>
		<nav class="hidden lg:flex gap-8" aria-label="Primary">
			{
				navItems.map((item) => (
					<a
						class="font-label-caps text-label-caps uppercase text-on-surface-variant hover:text-primary transition-colors font-bold go-to-section"
						href={item.href}
					>
						{item.label}
					</a>
				))
			}
		</nav>
		<div class="flex gap-4">
			<!-- <a
				href="/cv.pdf"
				class="hidden md:inline-flex items-center btn-secondary px-6 py-2 rounded font-label-caps text-label-caps uppercase"
			>
				Download CV
			</a> -->
			<a
				id="bookButton"
				href="#contact"
				class="btn-primary inline-flex items-center px-6 py-2 rounded font-label-caps text-label-caps uppercase go-to-section"
			>
				Let's Talk
			</a>
		</div>
	</div>
</header>

<main class="pt-20">
	<!-- Hero -->
	<section class="bg-surface-container-highest relative overflow-hidden">
		<div
			class="absolute top-0 right-0 w-1/2 h-full bg-primary-container transform origin-bottom-left -skew-x-12 translate-x-32 hidden lg:block opacity-20"
		>
		</div>
		<div
			class="absolute -bottom-32 -left-32 w-96 h-96 bg-primary rounded-full blur-3xl opacity-10"
		>
		</div>
		<div
			class="max-w-container-max mx-auto px-margin-page pt-32 pb-section-gap relative z-10"
		>
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-gutter items-center">
				<div class="flex flex-col justify-center items-start">
					<div
						class="flex items-center gap-3 mb-stack-lg bg-surface px-4 py-2 rounded-full border border-outline-variant shadow-sm"
					>
						<span class="relative flex h-3 w-3">
							<span
								class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"
							></span>
							<span
								class="relative inline-flex rounded-full h-3 w-3 bg-primary"
							></span>
						</span>
						<span
							class="font-label-caps text-label-caps uppercase text-primary font-bold"
						>
							Available for new opportunities
						</span>
					</div>
					<h1
						class="font-headline-xl text-headline-xl-mobile md:text-headline-xl text-on-background mb-stack-lg max-w-3xl"
					>
						Engineered for Growth
					</h1>
					<p
						class="font-body-lg text-body-lg text-on-surface-variant mb-stack-lg max-w-xl text-xl"
					>
						Empowering marketing teams and tech leaders with seamless technical setups, lightning-fast web applications, and reliable infrastructure. I take the technical heavy lifting off your plate so you can focus on driving traffic and scaling revenue.
					</p>
					<div class="flex gap-4 mt-stack-md">
						<a
							href="#projects"
							class="go-to-section btn-inverse inline-flex items-center px-8 py-4 rounded font-label-caps text-label-caps uppercase tracking-wider"
						>
							Case Studies
						</a>
					</div>
				</div>
				<div class="hidden lg:flex justify-end items-center relative">
					<div
						class="w-4/5 aspect-square bg-gradient-to-tr from-primary to-primary-container rounded-2xl shadow-2xl transform rotate-3 flex items-center justify-center p-8 overflow-hidden relative"
					>
						<div
							class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10 mix-blend-overlay"
						>
						</div>
						<div
							class="font-code-snippet text-on-primary w-full max-h-full overflow-hidden text-sm opacity-80 leading-relaxed shadow-inner bg-on-background/10 p-6 rounded-lg"
						>
							<pre><code>{heroCodeSnippet}</code></pre>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Trusted by -->
	<section
		id="partners"
		class="border-y border-surface-container-high py-section-gap bg-surface-container-lowest"
		aria-label="Trusted by"
	>
		<div class="max-w-container-max mx-auto px-margin-page">
			<p
				class="font-label-caps text-label-caps uppercase text-outline font-bold text-center mb-8 tracking-widest"
			>
				Trusted by tech leaders at
			</p>
			<div
				class="flex flex-wrap justify-center items-center gap-12 md:gap-24 opacity-70 grayscale hover:grayscale-0 transition-all duration-500"
			>
				{
					partnerLogos.map((logo) => (
						<img
							alt={logo.alt}
							src={logo.src}
							class="h-10 w-auto transition-transform hover:scale-105"
							loading="lazy"
							decoding="async"
						/>
					))
				}
			</div>
		</div>
	</section>

	<!-- Technical Arsenal -->
	<section
		id="stack"
		class="py-section-gap max-w-container-max mx-auto px-margin-page"
	>
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-center">
			<div class="lg:col-span-4 pr-8">
				<div class="w-16 h-2 bg-primary-container mb-6"></div>
				<h2
					class="font-headline-lg text-headline-lg text-on-background mb-stack-md"
				>
					Technical Expertise
				</h2>
				<p
					class="font-body-md text-body-md text-on-surface-variant text-lg"
				>
					Selected technologies utilized to deliver scalable, secure, and
					performant web solutions.
				</p>
			</div>
			<div class="lg:col-span-8 mt-12 lg:mt-0">
				<ul class="grid grid-cols-2 md:grid-cols-3 gap-6">
					{
						technologies.map((tech) => (
							<li class="flex items-center gap-4 p-6 border-2 border-surface-container-high hover:border-primary-container hover:shadow-lg transition-all duration-300 rounded-xl bg-surface-container-lowest group">
								<span
									class="material-symbols-outlined text-3xl text-primary group-hover:text-primary-container transition-colors"
									style="font-variation-settings: 'FILL' 1;"
									aria-hidden="true"
								>
									{tech.icon}
								</span>
								<span class="font-body-md text-body-md text-on-background font-bold tracking-tight">
									{tech.label}
								</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>

	<!-- Featured Work -->
	<section
		id="projects"
		class="py-section-gap bg-on-background text-surface px-margin-page"
	>
		<div class="max-w-container-max mx-auto">
			<div class="mb-20 flex flex-col items-center text-center">
				<h2
					class="font-headline-lg text-headline-lg text-surface mb-stack-sm"
				>
					Real-World Implementations
				</h2>
				<p
					class="font-body-md text-body-md text-surface-variant max-w-2xl text-lg"
				>
					Showcasing real-world implementations of technical solutions that have driven measurable business results.
				</p>
			</div>

			<ProjectsSlider projects={projects} />
		</div>
	</section>

	<!-- Contact CTA -->
	<section
		id="contact"
		class="py-section-gap mx-auto bg-[url('/img/light-bg.webp')] bg-cover bg-center bg-no-repeat"
	>
		<div
			class="bg-surface-container-lowest border border-outline-variant p-12 md:p-24 rounded text-center max-w-4xl mx-auto"
		>
			<h2
				class="font-headline-xl text-headline-xl-mobile md:text-headline-xl text-on-background mb-stack-md"
			>
				Free Consultation
			</h2>
			<p
				class="font-body-lg text-body-lg text-on-surface-variant mb-12 max-w-2xl mx-auto"
			>
				Book a 30-minute, zero-pressure strategy call. There is no sales pitch. We will look under the hood of your current technical setup and identify bottlenecks. You will walk away with actionable advice and clear recommendations to scale your web presence—whether we decide to work together or not.
			</p>
			<div
				class="flex flex-col sm:flex-row justify-center items-center gap-6"
			>
				{
					ctaActions.map((action) => (
						<a
							href={action.href}
							class:list={[
								"inline-flex justify-center items-center px-8 py-4 rounded font-label-caps text-label-caps uppercase w-full sm:w-auto",
								action.variant === "primary"
									? "btn-primary"
									: "btn-secondary",
							]}
							target={action.target}
						>
							{action.label}
						</a>
					))
				}
			</div>
		</div>
	</section>
</main>

<footer class="w-full bg-surface border-t border-outline-variant">
	<div
		class="grid grid-cols-1 md:grid-cols-2 gap-gutter max-w-container-max mx-auto px-margin-page py-16"
	>
		<div class="flex flex-col gap-4">
			<span
				class="font-headline-md text-headline-md font-extrabold text-on-background"
			>
				Nick Nikolaev
			</span>
			<p
				class="font-body-md text-body-md text-on-surface-variant max-w-sm"
			>
				Empowering marketing teams and tech leaders with seamless technical setups, lightning-fast web applications, and reliable infrastructure.
			</p>
			<p
				class="font-body-md text-body-md text-on-surface-variant opacity-80 mt-8"
			>
				© {currentYear} Nikolay Nikolaev. Full Stack Engineer.
			</p>
		</div>
		<nav
			class="flex flex-col md:items-end gap-6"
			aria-label="Social and contact"
		>
			<div class="flex flex-col md:flex-row gap-6 md:gap-8">
				{
					socialLinks.map((link) => (
						<a
							class="font-label-caps text-label-caps uppercase font-bold text-on-surface-variant hover:text-primary-container transition-colors duration-300 tracking-widest"
							href={link.href}
						>
							{link.label}
						</a>
					))
				}
			</div>
		</nav>
	</div>
</footer>

<script>
	import "./main";
</script>
