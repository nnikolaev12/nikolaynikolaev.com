---
interface NavItem {
	label: string;
	href: string;
}

interface PartnerLogo {
	src: string;
	alt: string;
}

interface Technology {
	label: string;
	icon: string;
}

interface Project {
	title: string;
	description: string;
	imageSrc: string;
	imageAlt: string;
	tags: string[];
	href: string;
	reverse?: boolean;
}

interface SocialLink {
	label: string;
	href: string;
}

interface CtaAction {
	label: string;
	href: string;
	variant: "primary" | "secondary";
}

const navItems: NavItem[] = [
	{ label: "Projects", href: "#projects" },
	{ label: "Stack", href: "#stack" },
	{ label: "Contact", href: "#contact" },
];

const partnerLogos: PartnerLogo[] = [
	{
		src: "img/fs-logo.webp",
		alt: "Fantastic Services Logo",
	},
	{
		src: "img/sensity-logo.webp",
		alt: "Sensity Logo",
	},
	{
		src: "img/upc-logo.webp",
		alt: "Ultimate Poker Coaching Logo",
	},
	{
		src: "img/blubito-logo.webp",
		alt: "Blubito Logo",
	},
	{
		src: "img/yotpo-logo.svg",
		alt: "Yotpo Logo",
	}
];

const technologies: Technology[] = [
	{ label: "React / Next.js", icon: "terminal" },
	{ label: "PostgreSQL", icon: "database" },
	{ label: "AWS / Cloudflare", icon: "cloud" },
	{ label: "WordPress", icon: "web" },
	{ label: "Tailwind CSS", icon: "css" },
	{ label: "REST / GraphQL", icon: "api" },
];

const projects: Project[] = [
	{
		title: "Enterprise Analytics Platform",
		description:
			"Migrated a legacy monolith to a decoupled architecture, improving data retrieval speeds by 40% and enhancing overall system resilience.",
		imageSrc:
			"https://lh3.googleusercontent.com/aida-public/AB6AXuAtqQg2khc3Dv944lbE-2NHJIvt-JLjzoirpYz7O3Y3M4CGzHiM8lvuaEOEZI3Z4wMccJWTXqlxphzbThKadZ9QDzKjxaWqLftA8t7DMFAiox9pb2Mk7K71IC5Y31pIikcaCF4Gr1CK8D5EkCijMREh873M20ojVkgK2H_GGKyNFbRJuV9h9Xe3pfOQfM3S27Q6xIqWdXcMjY05f44XDc3P2rsLYCjl6JhxZD1ibilElYgiVQohdKYZoaVokrmg-k_iy6BVKgDDIAIM",
		imageAlt: "Enterprise Analytics Platform Dashboard",
		tags: ["Next.js", "PostgreSQL"],
		href: "#",
	},
	{
		title: "Global Marketing Hub",
		description:
			"Developed a headless WordPress solution serving content to multiple regional frontends, ensuring high availability via Cloudflare edge caching.",
		imageSrc:
			"https://lh3.googleusercontent.com/aida-public/AB6AXuCA2c1xfAciviFhZra6X_FrohyZC8IQ0PTwV-Q0IzZQ0lAEfow7ifri4Ozqb5QoajMOjd5wa2J_hynlJlBlHlVpH_JZdVXEqoExWIKG7AluEnJhHOlQUMTXOWJPqo_8hCiQcAN0Yju3LiE1WHK2iIxqeng5eaPfhaztaSWK6cvVIe2PxnkHCsotGx5RentvIr2tUCAn-341p7RJg5fdVThtJJWhdO4xWDucTm7kvnPkfAF9uBGGTgs_NkK8UUphpMyp6l8o5UMnfWfk",
		imageAlt: "Global Marketing Hub Landing Page",
		tags: ["WordPress", "AWS"],
		href: "#",
		reverse: true,
	},
];

const socialLinks: SocialLink[] = [
	{ label: "LinkedIn", href: "https://www.linkedin.com/in/nikolay-nikolaev-78992268/" },
	{ label: "GitHub", href: "https://github.com/nnikolaev12" },
	{ label: "Email", href: "mailto:me@nickolaynikolaev.com" },
];

const ctaActions: CtaAction[] = [
	{ label: "Book a Meeting", href: "https://calendly.com/nicknickolaev/first-30min", variant: "primary" },
	{ label: "Download CV", href: "docs/Resume.pdf", variant: "secondary" },
];

const heroCodeSnippet = `const Developer = {
  name: 'Nick',
  role: 'Web Developer',
  skills: [
    'PHP', 'Python', 'SQL',
	'HTML/CSS', 'JavaScript'
  ],
  mission: 'Web presence at scale',
  execute: () => {
    return buildRobustSolutions();
  }
};`;

const currentYear = new Date().getFullYear();
---

<header
	class="fixed top-0 w-full z-[100] bg-background/90 backdrop-blur-md border-b border-outline-variant"
>
	<div
		class="flex justify-between items-center max-w-container-max mx-auto px-margin-page h-20"
	>
		<a href="/" class="flex items-center gap-4">
			<img
				alt="Nikolay Nikolaev Logo"
				class="h-10 w-auto"
				src="/img/nn-logo-transp.webp"
				width="40"
				height="40"
				loading="eager"
				decoding="async"
			/>
			<span
				class="font-headline-md text-headline-md font-extrabold text-on-background hidden md:block"
			>
				Nick Nikolaev
			</span>
		</a>
		<nav class="hidden lg:flex gap-8" aria-label="Primary">
			{
				navItems.map((item) => (
					<a
						class="font-label-caps text-label-caps uppercase text-on-surface-variant hover:text-primary transition-colors font-bold"
						href={item.href}
					>
						{item.label}
					</a>
				))
			}
		</nav>
		<div class="flex gap-4">
			<!-- <a
				href="/cv.pdf"
				class="hidden md:inline-flex items-center btn-secondary px-6 py-2 rounded font-label-caps text-label-caps uppercase"
			>
				Download CV
			</a> -->
			<a
				href="#contact"
				class="btn-primary inline-flex items-center px-6 py-2 rounded font-label-caps text-label-caps uppercase"
			>
				Book Meeting
			</a>
		</div>
	</div>
</header>

<main class="pt-20">
	<!-- Hero -->
	<section class="bg-surface-container-highest relative overflow-hidden">
		<div
			class="absolute top-0 right-0 w-1/2 h-full bg-primary-container transform origin-bottom-left -skew-x-12 translate-x-32 hidden lg:block opacity-20"
		>
		</div>
		<div
			class="absolute -bottom-32 -left-32 w-96 h-96 bg-primary rounded-full blur-3xl opacity-10"
		>
		</div>
		<div
			class="max-w-container-max mx-auto px-margin-page pt-32 pb-section-gap relative z-10"
		>
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-gutter items-center">
				<div class="flex flex-col justify-center items-start">
					<div
						class="flex items-center gap-3 mb-stack-lg bg-surface px-4 py-2 rounded-full border border-outline-variant shadow-sm"
					>
						<span class="relative flex h-3 w-3">
							<span
								class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"
							></span>
							<span
								class="relative inline-flex rounded-full h-3 w-3 bg-primary"
							></span>
						</span>
						<span
							class="font-label-caps text-label-caps uppercase text-primary font-bold"
						>
							Available for new opportunities
						</span>
					</div>
					<h1
						class="font-headline-xl text-headline-xl-mobile md:text-headline-xl text-on-background mb-stack-lg max-w-3xl"
					>
						Architecting robust web solutions for tech leaders
					</h1>
					<p
						class="font-body-lg text-body-lg text-on-surface-variant mb-stack-lg max-w-xl text-xl"
					>
						I specialize in building, maintaining, and extending
						high-performance marketing websites and web applications. Helping
						CTOs and Engineering Managers scale their digital presence with
						clean code and reliable infrastructure.
					</p>
					<div class="flex gap-4 mt-stack-md">
						<a
							href="#projects"
							class="btn-inverse inline-flex items-center px-8 py-4 rounded font-label-caps text-label-caps uppercase tracking-wider"
						>
							View Projects
						</a>
					</div>
				</div>
				<div class="hidden lg:flex justify-end items-center relative">
					<div
						class="w-4/5 aspect-square bg-gradient-to-tr from-primary to-primary-container rounded-2xl shadow-2xl transform rotate-3 flex items-center justify-center p-8 overflow-hidden relative"
					>
						<div
							class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10 mix-blend-overlay"
						>
						</div>
						<div
							class="font-code-snippet text-on-primary w-full max-h-full overflow-hidden text-sm opacity-80 leading-relaxed shadow-inner bg-on-background/10 p-6 rounded-lg"
						>
							<pre><code>{heroCodeSnippet}</code></pre>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Trusted by -->
	<section
		class="border-y border-surface-container-high py-12 bg-surface-container-lowest"
		aria-label="Trusted by"
	>
		<div class="max-w-container-max mx-auto px-margin-page">
			<p
				class="font-label-caps text-label-caps uppercase text-outline font-bold text-center mb-8 tracking-widest"
			>
				Trusted by technical teams at
			</p>
			<div
				class="flex flex-wrap justify-center items-center gap-12 md:gap-24 opacity-70 grayscale hover:grayscale-0 transition-all duration-500"
			>
				{
					partnerLogos.map((logo) => (
						<img
							alt={logo.alt}
							src={logo.src}
							class="h-10 w-auto transition-transform hover:scale-105"
							loading="lazy"
							decoding="async"
						/>
					))
				}
			</div>
		</div>
	</section>

	<!-- Technical Arsenal -->
	<section
		id="stack"
		class="py-section-gap max-w-container-max mx-auto px-margin-page"
	>
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-center">
			<div class="lg:col-span-4 pr-8">
				<div class="w-16 h-2 bg-primary-container mb-6"></div>
				<h2
					class="font-headline-lg text-headline-lg text-on-background mb-stack-md"
				>
					Technical Arsenal
				</h2>
				<p
					class="font-body-md text-body-md text-on-surface-variant text-lg"
				>
					Selected technologies utilized to deliver scalable, secure, and
					performant web solutions.
				</p>
			</div>
			<div class="lg:col-span-8 mt-12 lg:mt-0">
				<ul class="grid grid-cols-2 md:grid-cols-3 gap-6">
					{
						technologies.map((tech) => (
							<li class="flex items-center gap-4 p-6 border-2 border-surface-container-high hover:border-primary-container hover:shadow-lg transition-all duration-300 rounded-xl bg-surface-container-lowest group">
								<span
									class="material-symbols-outlined text-3xl text-primary group-hover:text-primary-container transition-colors"
									style="font-variation-settings: 'FILL' 1;"
									aria-hidden="true"
								>
									{tech.icon}
								</span>
								<span class="font-body-md text-body-md text-on-background font-bold tracking-tight">
									{tech.label}
								</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>

	<!-- Featured Work -->
	<section
		id="projects"
		class="py-section-gap bg-on-background text-surface px-margin-page"
	>
		<div class="max-w-container-max mx-auto">
			<div class="mb-20 flex flex-col items-center text-center">
				<h2
					class="font-headline-lg text-headline-lg text-surface mb-stack-sm"
				>
					Featured Work
				</h2>
				<p
					class="font-body-md text-body-md text-surface-variant max-w-2xl text-lg"
				>
					A selection of recent projects demonstrating architectural decisions
					and implementation quality.
				</p>
			</div>
			<div class="flex flex-col gap-24">
				{
					projects.map((project) => (
						<article
							class:list={[
								"flex flex-col gap-12 items-center group",
								project.reverse ? "lg:flex-row-reverse" : "lg:flex-row",
							]}
						>
							<div class="w-full lg:w-3/5 h-96 lg:h-[500px] overflow-hidden rounded-2xl shadow-2xl relative">
								<div class="absolute inset-0 bg-primary/20 group-hover:bg-transparent transition-colors duration-500 z-10" />
								<img
									alt={project.imageAlt}
									src={project.imageSrc}
									class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
									loading="lazy"
									decoding="async"
								/>
							</div>
							<div class="w-full lg:w-2/5 flex flex-col justify-center">
								<div class="flex gap-3 mb-6">
									{project.tags.map((tag) => (
										<span class="font-code-snippet text-code-snippet bg-surface-variant/10 border border-surface-variant/20 px-4 py-1.5 rounded-full text-primary-fixed">
											{tag}
										</span>
									))}
								</div>
								<h3 class="font-headline-xl text-4xl font-extrabold text-surface mb-6">
									{project.title}
								</h3>
								<p class="font-body-lg text-body-lg text-surface-variant mb-10 text-lg opacity-90 leading-relaxed">
									{project.description}
								</p>
								<a
									class="inline-flex items-center gap-3 font-label-caps text-label-caps uppercase text-primary-container hover:text-primary-fixed hover:gap-5 transition-all duration-300 tracking-widest"
									href={project.href}
								>
									View Case Study
									<span
										class="material-symbols-outlined text-xl"
										aria-hidden="true"
									>
										arrow_forward
									</span>
								</a>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- Contact CTA -->
	<section
		id="contact"
		class="py-section-gap mx-auto bg-[url('/img/light-bg.webp')] bg-cover bg-center bg-no-repeat"
	>
		<div
			class="bg-surface-container-lowest border border-outline-variant p-12 md:p-24 rounded text-center max-w-4xl mx-auto"
		>
			<h2
				class="font-headline-xl text-headline-xl-mobile md:text-headline-xl text-on-background mb-stack-md"
			>
				Ready to scale your web presence?
			</h2>
			<p
				class="font-body-lg text-body-lg text-on-surface-variant mb-12 max-w-2xl mx-auto"
			>
				Let's discuss your current infrastructure and how we can optimize it
				for performance, security, and growth.
			</p>
			<div
				class="flex flex-col sm:flex-row justify-center items-center gap-6"
			>
				{
					ctaActions.map((action) => (
						<a
							href={action.href}
							class:list={[
								"inline-flex justify-center items-center px-8 py-4 rounded font-label-caps text-label-caps uppercase w-full sm:w-auto",
								action.variant === "primary"
									? "btn-primary"
									: "btn-secondary",
							]}
						>
							{action.label}
						</a>
					))
				}
			</div>
		</div>
	</section>
</main>

<footer class="w-full bg-surface border-t border-outline-variant">
	<div
		class="grid grid-cols-1 md:grid-cols-2 gap-gutter max-w-container-max mx-auto px-margin-page py-16"
	>
		<div class="flex flex-col gap-4">
			<span
				class="font-headline-md text-headline-md font-extrabold text-on-background"
			>
				Nikolay Nikolaev
			</span>
			<p
				class="font-body-md text-body-md text-on-surface-variant max-w-sm"
			>
				Built for performance and precision. Minimalist architecture for
				maximum impact.
			</p>
			<p
				class="font-body-md text-body-md text-on-surface-variant opacity-80 mt-8"
			>
				© {currentYear} Nikolay Nikolaev. Built for performance and precision.
			</p>
		</div>
		<nav
			class="flex flex-col md:items-end gap-6"
			aria-label="Social and contact"
		>
			<div class="flex flex-col md:flex-row gap-6 md:gap-8">
				{
					socialLinks.map((link) => (
						<a
							class="font-label-caps text-label-caps uppercase font-bold text-on-surface-variant hover:text-primary-container transition-colors duration-300 tracking-widest"
							href={link.href}
						>
							{link.label}
						</a>
					))
				}
			</div>
		</nav>
	</div>
</footer>
