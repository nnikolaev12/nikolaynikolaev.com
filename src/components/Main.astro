---
import type { Project } from "../types/project";
import ProjectsSlider from "./projects/ProjectsSlider.astro";

interface NavItem {
	label: string;
	href: string;
}

interface PartnerLogo {
	src: string;
	alt: string;
}

interface StackChip {
	label: string;
	iconSrc?: string;
	icon?: string;
}

interface StackDomain {
	title: string;
	blurb: string;
	chips: StackChip[];
}

interface SocialLink {
	label: string;
	href: string;
	iconPath: string;
}

interface CtaAction {
	label: string;
	href: string;
	variant: "primary" | "secondary";
	target: "_blank" | "_self";
}

const navItems: NavItem[] = [
	{ label: "Clients", href: "#clients" },
	{ label: "How I ship", href: "#stack" },
	{ label: "Case Studies", href: "#projects" },
];

const partnerLogos: PartnerLogo[] = [
	{
		src: "/img/logos/yotpo-logo.svg",
		alt: "Yotpo Logo",
	},
	{
		src: "/img/logos/sensity-logo.webp",
		alt: "Sensity Logo",
	},
	{
		src: "/img/logos/upc-logo.webp",
		alt: "Ultimate Poker Coaching Logo",
	},
	{
		src: "/img/logos/blubito-logo.webp",
		alt: "Blubito Logo",
	},
	{
		src: "/img/logos/fs-logo.webp",
		alt: "Fantastic Services Logo",
	}
];

const stackDomains: StackDomain[] = [
	{
		title: "Marketing systems",
		blurb:
			"Page builders and CMS architecture the marketing team can ship on without waiting on engineering.",
		chips: [
			{ label: "WordPress", iconSrc: "/img/tech/wp.svg" },
			{ label: "Shopify", iconSrc: "/img/tech/shopify.svg" },
			{ label: "Custom", icon: "dashboard_customize" },
		],
	},
	{
		title: "Infrastructure",
		blurb:
			"Caching, security, and edge delivery that hold up under enterprise traffic.",
		chips: [
			{ label: "AWS", iconSrc: "/img/tech/aws.svg" },
			{ label: "Google Cloud", iconSrc: "/img/tech/google-cloud.svg" },
			{ label: "Cloudflare", iconSrc: "/img/tech/cloudflare.svg" },
		],
	},
	{
		title: "Applied AI",
		blurb: "Agentic workflows that accelerate content and front-end production.",
		chips: [
			{ label: "AI integrations", icon: "smart_toy" },
			{ label: "Agentic workflows", icon: "account_tree" },
		],
	},
	{
		title: "Growth engineering",
		blurb:
			"Search, generative-engine visibility, and experimentation wired into the stack.",
		chips: [
			{ label: "SEO", icon: "search" },
			{ label: "GEO / AI search", icon: "public" },
			{ label: "A/B testing", icon: "science" },
			{ label: "Analytics", icon: "analytics" },
		],
	},
];

const projects: Project[] = [
	{
		title: "Yotpo",
		innerTitle: "A marketing site the team can actually ship on",
		description:
			"I built a block-based page builder and AI content workflows so Yotpo’s marketing team can ship campaigns without waiting on engineering — on a site that has to hold enterprise traffic.",
		mainContent: `<ul>
			<li><strong>The Challenge:</strong> yotpo.com is a high-traffic marketing site. The team needed to iterate on campaigns quickly, keep performance stable under load, and track what converted — without a developer ticket for every page.</li>
			<li><strong>The Solution:</strong> I built a custom Gutenberg block-based page builder so marketing can assemble pages themselves. I added AI workflows to speed up front-end and content production, and set up AWS caching, migration, and security so the site holds under load.</li>
			<li><strong>The Tech Stack:</strong> WordPress, AWS, custom Gutenberg blocks, AI workflows, A/B testing, analytics.</li>
			<li><strong>The Impact:</strong> Marketing launches, tests, and optimizes campaigns without waiting on engineering. The site stays up under enterprise traffic.</li>
		</ul>`,
		imageSrc: "/img/projects/yotpo-desktop.webp",
		imageAlt: "Yotpo marketing website",
		tags: ["WordPress", "AWS"],
		href: "https://yotpo.com/",
	},
	{
		title: "Ultimate Poker Coaching",
		innerTitle: "Marketplace, payments, and calendar in one platform",
		description:
			"I built a coaching marketplace on WordPress: discovery, Stripe payments, and scheduling, delivered through Cloudflare.",
		mainContent: `<ul>
			<li><strong>The Challenge:</strong> The client needed one platform to connect poker coaches with students — discovery, payments, and calendars — instead of stitching together separate tools.</li>
			<li><strong>The Solution:</strong> I built a custom WordPress marketplace for the coaching lifecycle: Stripe for payments, scheduling so coaches manage their own availability, and Cloudflare for delivery and security.</li>
			<li><strong>The Tech Stack:</strong> Custom WordPress, Stripe, Cloudflare, scheduling.</li>
			<li><strong>The Impact:</strong> Coaches can take bookings and get paid in one place. The business can add users without adding admin overhead.</li>
		</ul>`,
		imageSrc: "/img/projects/ultimatepokercoaching-desktop.webp",
		imageAlt: "Ultimate Poker Coaching marketplace",
		tags: ["WordPress", "Cloudflare", "Stripe"],
		href: "https://ultimatepokercoaching.com/",
		reverse: true,
	},
	{
		title: "Sensity AI",
		innerTitle: "A multilingual marketing site for AI security",
		description:
			"I built Sensity’s multilingual marketing site so a complex AI-security story could rank, load, and be updated by their team — not by a developer queue.",
		mainContent: `<ul>
			<li><strong>The Challenge:</strong> An AI security company needed a site that could explain deepfake detection to a global audience, rank in search, and be updated by marketing without a developer queue.</li>
			<li><strong>The Solution:</strong> I built a multilingual marketing site focused on performance and SEO, with a backend marketing can publish to, and support for their custom investigation visuals.</li>
			<li><strong>The Tech Stack:</strong> WordPress, multilingual architecture, technical SEO, custom visuals.</li>
			<li><strong>The Impact:</strong> The team publishes and scales content themselves. The site is built to rank and to load for a global audience.</li>
		</ul>`,
		imageSrc: "/img/projects/sensity-desktop.webp",
		imageAlt: "Sensity AI marketing website",
		tags: ["WordPress"],
		href: "https://sensity.ai/",
	},
	{
		title: "Hermes Plugin",
		innerTitle: "One plugin for several high-traffic media sites",
		description:
			"I extended the plugin that powers several high-traffic iGaming media sites — shared blocks, APIs, and tracking instead of per-site snowflakes.",
		mainContent: `<ul>
			<li><strong>The Challenge:</strong> Functionality had to be maintained and scaled across several high-traffic iGaming media sites, not rebuilt per domain.</li>
			<li><strong>The Solution:</strong> I maintained and extended Hermes, a central WordPress plugin: custom Gutenberg blocks, third-party APIs, and usage tracking shared across the company’s sites.</li>
			<li><strong>The Tech Stack:</strong> WordPress plugin development, PHP, Google Cloud, third-party APIs, Gutenberg.</li>
			<li><strong>The Impact:</strong> Content teams manage multiple sites from one plugin. Shared blocks and APIs cut the overhead of shipping the same feature N times.</li>
		</ul>`,
		imageSrc: "/img/projects/onthedotmedia-desktop.png",
		imageAlt: "High-traffic iGaming media sites powered by Hermes",
		tags: ["WordPress", "Google Cloud"],
		href: "#",
		reverse: true,
	},
];

const socialLinks: SocialLink[] = [
	{
		label: "LinkedIn",
		href: "https://www.linkedin.com/in/nikolay-nikolaev-78992268/",
		iconPath:
			"M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z",
	},
	{
		label: "GitHub",
		href: "https://github.com/nnikolaev12",
		iconPath:
			"M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
	},
];

const ctaActions: CtaAction[] = [
	{ label: "Book a call", href: "https://calendar.app.google/cKy7EK93wS6esepB6", variant: "primary", target: "_blank" },
	{ label: "Email me", href: "mailto:me@nikolaynikolaev.com", variant: "secondary", target: "_self" },
];

const heroCodeSnippet = `const Engineer = {
  name: 'Nick',
  role: 'Full Stack Web Engineer',
  skills: [
    'Marketing systems',
    'Infrastructure',
    'Applied AI',
    'Growth engineering',
  ],
  mission: 'Engineered for Growth',
  execute: () => {
    return buildRobustSolutions();
  }
};`;

const currentYear = new Date().getFullYear();
---

<header
	class="fixed top-0 w-full z-[100] bg-background/90 backdrop-blur-md border-b border-outline-variant"
>
	<div
		class="flex justify-between items-center max-w-container-max mx-auto px-margin-page h-20"
	>
		<a href="/" class="flex items-center gap-4">
			<img
				alt="Nick Nikolaev"
				class="h-10 w-auto"
				src="/img/logos/nn-logo-transp.webp"
				width="40"
				height="40"
				loading="eager"
				decoding="async"
			/>
			<span
				class="font-headline-md text-headline-md font-extrabold text-on-background hidden md:block"
			>
				Nick Nikolaev
			</span>
		</a>
		<nav class="hidden lg:flex gap-8" aria-label="Primary">
			{
				navItems.map((item) => (
					<a
						class="font-label-caps text-label-caps uppercase text-on-surface-variant hover:text-primary transition-colors font-bold go-to-section"
						href={item.href}
					>
						{item.label}
					</a>
				))
			}
		</nav>
		<div class="flex gap-4">
			<!-- <a
				href="/cv.pdf"
				class="hidden md:inline-flex items-center btn-secondary px-6 py-2 rounded font-label-caps text-label-caps uppercase"
			>
				Download CV
			</a> -->
			<a
				id="bookButton"
				href="#contact"
				class="btn-primary inline-flex items-center px-6 py-2 rounded font-label-caps text-label-caps uppercase go-to-section"
			>
				Let's talk
			</a>
		</div>
	</div>
</header>

<main class="pt-20">
	<!-- Hero -->
	<section class="bg-surface-container-highest relative overflow-hidden">
		<div
			class="absolute top-0 right-0 w-1/2 h-full bg-primary-container transform origin-bottom-left -skew-x-12 translate-x-32 hidden lg:block opacity-20"
		>
		</div>
		<div
			class="absolute -bottom-32 -left-32 w-96 h-96 bg-primary rounded-full blur-3xl opacity-10"
		>
		</div>
		<div
			class="max-w-container-max mx-auto px-margin-page pt-32 pb-section-gap relative z-10"
		>
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-gutter items-center">
				<div class="flex flex-col justify-center items-start">
					<div
						class="flex items-center gap-3 mb-stack-lg bg-surface px-4 py-2 rounded-full border border-outline-variant shadow-sm"
					>
						<span class="relative flex h-3 w-3">
							<span
								class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"
							></span>
							<span
								class="relative inline-flex rounded-full h-3 w-3 bg-primary"
							></span>
						</span>
						<span
							class="font-label-caps text-label-caps uppercase text-primary font-bold"
						>
							Available for new projects
						</span>
					</div>
					<h1
						class="font-headline-xl text-headline-xl-mobile md:text-headline-xl text-on-background mb-stack-lg max-w-3xl"
					>
						Engineered
						<br/>
						so marketing
						<br/>
						can ship
					</h1>
					<p
						class="font-body-lg text-body-lg text-on-surface-variant mb-stack-lg max-w-xl text-xl"
					>
						I build the CMS, infrastructure, and growth stack so marketing can launch — and the site holds up when traffic hits.
					</p>
					<div class="flex flex-wrap gap-4 mt-stack-md">
						<a
							href="https://calendar.app.google/cKy7EK93wS6esepB6"
							class="btn-primary inline-flex items-center px-8 py-4 rounded font-label-caps text-label-caps uppercase tracking-wider"
							target="_blank"
							rel="noopener noreferrer"
						>
							Book a call
						</a>
						<a
							href="#projects"
							class="go-to-section btn-inverse inline-flex items-center px-8 py-4 rounded font-label-caps text-label-caps uppercase tracking-wider"
						>
							Case Studies
						</a>
					</div>
				</div>
				<div class="hidden lg:flex justify-end items-center relative">
					<div
						class="hero-flip w-4/5 aspect-square"
						tabindex="0"
						aria-label="Card for Nick Nikolaev. Hover or focus to flip it."
					>
						<div class="hero-flip-inner">
							<div class="hero-flip-face">
								<div
									class="h-full w-full overflow-hidden rounded-2xl bg-surface shadow-2xl"
								>
									<img
										src="/img/me.webp"
										alt="Nick Nikolaev"
										width="675"
										height="675"
										class="h-full w-full origin-[center_38%] object-cover"
										draggable="false"
										loading="eager"
										decoding="async"
									/>
								</div>
							</div>
							<div class="hero-flip-face hero-flip-face-back">
								<div
									class="flex h-full w-full items-center justify-center overflow-hidden rounded-2xl bg-gradient-to-tr from-primary to-primary-container p-8 shadow-2xl relative"
								>
									<div
										class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10 mix-blend-overlay"
									>
									</div>
									<div
										class="font-code-snippet text-on-primary w-full max-h-full overflow-hidden text-sm opacity-80 leading-relaxed shadow-inner bg-on-background/10 p-6 rounded-lg"
									>
										<pre><code>{heroCodeSnippet}</code></pre>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Clients -->
	<section
		id="clients"
		class="border-y border-surface-container-high py-section-gap bg-surface-container-lowest"
		aria-label="Clients"
	>
		<div class="max-w-container-max mx-auto px-margin-page">
			<p
				class="font-label-caps text-label-caps uppercase text-outline font-bold text-center mb-8 tracking-widest"
			>
				Work I’ve shipped for
			</p>
			<div
				class="relative overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_12%,black_88%,transparent)]"
			>
				<div class="logo-marquee">
					{
						[...partnerLogos, ...partnerLogos].map((logo, index) => (
							<img
								alt={index < partnerLogos.length ? logo.alt : ""}
								aria-hidden={index >= partnerLogos.length}
								src={logo.src}
								class="h-10 w-auto shrink-0 grayscale opacity-60 transition duration-300 hover:grayscale-0 hover:opacity-100 hover:scale-110"
								loading="lazy"
								decoding="async"
							/>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<!-- How I ship -->
	<section
		id="stack"
		class="scroll-mt-20 py-16 md:py-section-gap"
	>
		<div class="max-w-container-max mx-auto px-6 lg:px-margin-page">
			<div class="w-16 h-2 bg-primary-container mb-6"></div>
			<h2
				class="font-headline-lg text-3xl md:text-headline-lg text-on-background mb-stack-md"
			>
				How I ship
			</h2>
			<p
				class="font-body-md text-body-md text-on-surface-variant text-lg max-w-xl mb-12 md:mb-16"
			>
				Four systems I use to get marketing sites live, fast, and measurable.
			</p>
			<ol>
				{
					stackDomains.map((domain, index) => (
						<li class="grid grid-cols-1 md:grid-cols-12 gap-3 md:gap-8 py-8 border-t border-outline-variant last:border-b">
							<div class="md:col-span-4 flex items-baseline gap-4">
								<span class="font-code-snippet text-code-snippet text-primary-container shrink-0">
									{String(index + 1).padStart(2, "0")}
								</span>
								<h3 class="font-headline-md text-headline-md text-on-background">
									{domain.title}
								</h3>
							</div>
							<div class="md:col-span-8 md:pt-1">
								<p class="font-body-md text-body-md text-on-surface-variant">
									{domain.blurb}
								</p>
								<ul class="flex flex-wrap gap-2 mt-4">
									{domain.chips.map((chip) => (
										<li class="inline-flex items-center gap-2 font-label-caps text-label-caps uppercase text-on-background border border-outline-variant px-3 py-1.5 rounded">
											{chip.iconSrc ? (
												<img
													src={chip.iconSrc}
													alt=""
													width="16"
													height="16"
													class="h-4 w-4 shrink-0 object-contain"
													aria-hidden="true"
												/>
											) : (
												<span
													class="material-symbols-outlined text-[16px] leading-none text-primary"
													style="font-variation-settings: 'FILL' 1;"
													aria-hidden="true"
												>
													{chip.icon}
												</span>
											)}
											{chip.label}
										</li>
									))}
								</ul>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- Case studies -->
	<section
		id="projects"
		class="py-section-gap bg-on-background text-surface px-margin-page"
	>
		<div class="max-w-container-max mx-auto">
			<div class="mb-20 flex flex-col items-center text-center">
				<h2
					class="font-headline-lg text-headline-lg text-surface mb-stack-sm"
				>
					Case studies
				</h2>
				<p
					class="font-body-md text-body-md text-surface-variant max-w-2xl text-lg"
				>
					Platforms where marketing could ship without waiting on engineering — or where the stack had to hold high-traffic media.
				</p>
			</div>

			<ProjectsSlider projects={projects} ariaLabel="Case studies" />
		</div>
	</section>

	<!-- Contact CTA -->
	<section
		id="contact"
		class="py-section-gap mx-auto bg-[url('/img/light-bg.webp')] bg-cover bg-center bg-no-repeat"
	>
		<div
			class="bg-surface-container-lowest border border-outline-variant p-12 md:p-24 rounded text-center max-w-4xl mx-auto"
		>
			<h2
				class="font-headline-xl text-headline-xl-mobile md:text-headline-xl text-on-background mb-stack-md"
			>
				Let’s talk
			</h2>
			<p
				class="font-body-lg text-body-lg text-on-surface-variant mb-12 max-w-2xl mx-auto"
			>
				Book a 30-minute call. No pitch. We’ll look at your current setup, find what’s blocking shipping or performance, and you’ll leave with a short list of next steps — whether we work together or not.
			</p>
			<div
				class="flex flex-col sm:flex-row justify-center items-center gap-6"
			>
				{
					ctaActions.map((action) => (
						<a
							href={action.href}
							class:list={[
								"inline-flex justify-center items-center px-8 py-4 rounded font-label-caps text-label-caps uppercase w-full sm:w-auto",
								action.variant === "primary"
									? "btn-primary"
									: "btn-secondary",
							]}
							target={action.target}
							rel={action.target === "_blank" ? "noopener noreferrer" : undefined}
						>
							{action.label}
						</a>
					))
				}
			</div>
		</div>
	</section>
</main>

<footer class="w-full bg-surface border-t border-outline-variant">
	<div
		class="grid grid-cols-1 md:grid-cols-2 gap-gutter max-w-container-max mx-auto px-margin-page py-16"
	>
		<div class="flex flex-col gap-4">
			<span
				class="font-headline-md text-headline-md font-extrabold text-on-background"
			>
				Nick Nikolaev
			</span>
			<p
				class="font-body-md text-body-md text-on-surface-variant max-w-sm"
			>
				Marketing platforms, infrastructure,
				<br />
				and growth engineering.
			</p>
			<p
				class="font-body-md text-body-md text-on-surface-variant opacity-80 mt-8"
			>
				© {currentYear} Nikolay Nikolaev.
			</p>
		</div>
		<nav
			class="flex flex-col md:items-end gap-6"
			aria-label="Social"
		>
			<div class="flex items-center gap-6">
				{
					socialLinks.map((link) => (
						<a
							class="inline-flex text-on-surface-variant hover:text-primary-container transition-colors duration-300"
							href={link.href}
							aria-label={link.label}
						>
							<svg
								class="size-6"
								viewBox="0 0 24 24"
								fill="currentColor"
								aria-hidden="true"
							>
								<path d={link.iconPath} />
							</svg>
						</a>
					))
				}
			</div>
		</nav>
	</div>
</footer>

<script>
	import "./main";
</script>

<style>
	.hero-flip {
		perspective: 1400px;
		cursor: pointer;
	}

